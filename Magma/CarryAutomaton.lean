module

public import Magma.CryptoProperties
import all Init.Data.Range.Basic

@[expose] public section

/-!
# Exact carry-automaton model of the Magma round function

Local transitions, matrix and Boolean dynamic programming, exact XOR-DDT
semantics and concrete path witnesses.
-/

open Magma.Internal Magma.GProperties

namespace Magma.CarryAutomaton

/-- XOR of two 4-bit digits, encoded as elements of `Fin 16`. -/
def xorDigit (x d : Fin 16) : Fin 16 :=
  ((BitVec.ofNat 4 x.val) ^^^ (BitVec.ofNat 4 d.val)).toFin

/-- The low four bits of x + k + c. Here c is a single carry bit. -/
def outputDigit (x k : Fin 16) (c : Fin 2) : Fin 16 :=
  ⟨(x.val + k.val + c.val) % 16, Nat.mod_lt _ (by decide)⟩

/-- The one-bit carry generated by x + k + c. -/
def nextCarry (x k : Fin 16) (c : Fin 2) : Fin 2 :=
  ⟨(x.val + k.val + c.val) / 16, by
    have hx := x.isLt
    have hk := k.isLt
    have hc := c.isLt
    omega⟩

/-- Each local addition is exactly its output digit plus 16 times the carry. -/
theorem addStep_correct (x k : Fin 16) (c : Fin 2) :
    x.val + k.val + c.val =
      (outputDigit x k c).val + 16 * (nextCarry x k c).val := by
  change x.val + k.val + c.val =
    (x.val + k.val + c.val) % 16 +
      16 * ((x.val + k.val + c.val) / 16)
  exact (Nat.mod_add_div _ _).symm

/--
  The state consists of TWO carry bits:
  the first follows x + k; the second follows (x XOR delta) + k.

  The output gives the 4-bit XOR difference of the resulting digits
  and the next pair of carries. This is one step of a 4-state
  finite transducer (not the complete 32-bit DDT yet).
-/
def xorCarryStep (k delta x : Fin 16) (state : Fin 2 × Fin 2) :
    Fin 16 × (Fin 2 × Fin 2) :=
  (xorDigit
      (outputDigit (xorDigit x delta) k state.2)
      (outputDigit x k state.1),
   (nextCarry x k state.1,
    nextCarry (xorDigit x delta) k state.2))

/--
  Count local inputs realizing the given output difference and next
  carry state. Every such count involves only sixteen possible digits.
-/
def transitionCount
    (k delta outDelta : Fin 16)
    (state nextState : Fin 2 × Fin 2) : Nat :=
  ((Finset.univ : Finset (Fin 16)).filter (fun x =>
    xorCarryStep k delta x state = (outDelta, nextState))).card

/-- Each local transition count is bounded by the 16 possible input digits. -/
theorem transitionCount_le_16
    (k delta outDelta : Fin 16)
    (state nextState : Fin 2 × Fin 2) :
    transitionCount k delta outDelta state nextState ≤ 16 := by
  unfold transitionCount
  calc
    ((Finset.univ : Finset (Fin 16)).filter (fun x =>
      xorCarryStep k delta x state = (outDelta, nextState))).card
        ≤ (Finset.univ : Finset (Fin 16)).card :=
          Finset.card_le_card (Finset.filter_subset _ _)
    _ = 16 := by simp

/--
  The same two-carry transition, now including RFC 8891 S-box `π i`.
  Its output difference is measured AFTER substitution but BEFORE rot11.
  A local DDT entry of `π i` alone is not sufficient here, because
  the two substituted inputs also depend on the carry states.
-/
def sboxCarryStep (i : Fin 8) (k delta x : Fin 16)
    (state : Fin 2 × Fin 2) : Fin 16 × (Fin 2 × Fin 2) :=
  let y₀ := outputDigit x k state.1
  let y₁ := outputDigit (xorDigit x delta) k state.2
  (xorDigit
      (π i (BitVec.ofNat 4 y₁.val)).toFin
      (π i (BitVec.ofNat 4 y₀.val)).toFin,
   (nextCarry x k state.1,
    nextCarry (xorDigit x delta) k state.2))

/-- A four-state transition count, incorporating the specified S-box. -/
def sboxTransitionCount
    (i : Fin 8) (k delta outDelta : Fin 16)
    (state nextState : Fin 2 × Fin 2) : Nat :=
  ((Finset.univ : Finset (Fin 16)).filter (fun x =>
    sboxCarryStep i k delta x state = (outDelta, nextState))).card

/-- The S-box/carry transition count never exceeds sixteen. -/
theorem sboxTransitionCount_le_16
    (i : Fin 8) (k delta outDelta : Fin 16)
    (state nextState : Fin 2 × Fin 2) :
    sboxTransitionCount i k delta outDelta state nextState ≤ 16 := by
  unfold sboxTransitionCount
  calc
    ((Finset.univ : Finset (Fin 16)).filter (fun x =>
      sboxCarryStep i k delta x state = (outDelta, nextState))).card
        ≤ (Finset.univ : Finset (Fin 16)).card :=
          Finset.card_le_card (Finset.filter_subset _ _)
    _ = 16 := by simp

/-- The two carry bits form a set of four states. -/
abbrev CarryState := Fin 2 × Fin 2

/-- Counts for one nibble, arranged as a 4×4 transition matrix.
    Entry (s,t) counts input digits giving the specified substituted
    XOR difference and taking state s to state t. -/
def carryMatrix
    (i : Fin 8) (keyDigit inputDiff outputDiff : Fin 16) :
    Matrix CarryState CarryState Nat :=
  Matrix.of (fun s t =>
    sboxTransitionCount i keyDigit inputDiff outputDiff s t)

/-- Matrix entries are exactly the previously verified local counts. -/
theorem carryMatrix_apply
    (i : Fin 8) (k d b : Fin 16) (s t : CarryState) :
    carryMatrix i k d b s t = sboxTransitionCount i k d b s t := by
  rfl

/-- Each matrix entry counts at most the sixteen input digits. -/
theorem carryMatrix_entry_le_16
    (i : Fin 8) (k d b : Fin 16) (s t : CarryState) :
    carryMatrix i k d b s t ≤ 16 := by
  change sboxTransitionCount i k d b s t ≤ 16
  exact sboxTransitionCount_le_16 i k d b s t

/-- Ordered product of the eight transition matrices, from
    the least-significant nibble (0) to the most-significant (7).
    A commutative `Finset.prod` would be inappropriate here. -/
def carryMatrixProduct
    (key diff target : Fin 8 → Fin 16) :
    Matrix CarryState CarryState Nat :=
  Fin.foldl 8
    (fun acc i => acc * carryMatrix i (key i) (diff i) (target i))
    1

/-- Initial carry state: both additions start with carry zero. -/
def initialRow : CarryState → Nat :=
  Pi.single ((0, 0) : CarryState) 1

/-- Four-state dynamic programming, equivalent to multiplying a row
    vector by each of the eight transition matrices in order. -/
def carryDP (key diff target : Fin 8 → Fin 16) :
    CarryState → Nat :=
  Fin.foldl 8
    (fun row i =>
      Matrix.vecMul row (carryMatrix i (key i) (diff i) (target i)))
    initialRow

/-- Sum over final carry states: overflow past bit 31 is discarded
    by addition modulo 2^32. -/
def carryMatrixCount (key diff target : Fin 8 → Fin 16) : Nat :=
  ∑ s : CarryState, carryMatrixProduct key diff target (0, 0) s

/-- The same count computed by row-vector dynamic programming. -/
def carryDPCount (key diff target : Fin 8 → Fin 16) : Nat :=
  ∑ s : CarryState, carryDP key diff target s

/-- Finite left folds of vector-matrix products can be combined
    into a single product of matrices, in the same order. -/
private theorem foldl_vecMul_eq_matrixProduct :
    ∀ (n : Nat) (mat : Fin n → Matrix CarryState CarryState Nat)
      (v : CarryState → Nat),
      Fin.foldl n (fun row i => Matrix.vecMul row (mat i)) v =
        Matrix.vecMul v (Fin.foldl n (fun acc i => acc * mat i) 1) := by
  intro n
  induction n with
  | zero =>
      intro mat v
      simp only [Fin.foldl_zero]
      exact (Matrix.vecMul_one v).symm
  | succ n ih =>
      intro mat v
      rw [Fin.foldl_succ_last, Fin.foldl_succ_last]
      rw [ih (fun i : Fin n => mat i.castSucc) v]
      exact Matrix.vecMul_vecMul v
        (Fin.foldl n (fun acc i => acc * mat i.castSucc) 1)
        (mat (Fin.last n))

/-- The dynamic-programming row is the (0,0)-th row of the
    ordered matrix product. No enumeration of 32-bit words occurs. -/
theorem carryDP_eq_matrixRow
    (key diff target : Fin 8 → Fin 16) :
    carryDP key diff target =
      carryMatrixProduct key diff target (0, 0) := by
  unfold carryDP carryMatrixProduct
  rw [foldl_vecMul_eq_matrixProduct]
  exact Matrix.single_one_vecMul
    ((0, 0) : CarryState)
    (Fin.foldl 8
      (fun acc i => acc * carryMatrix i (key i) (diff i) (target i))
      1)

/-- The two equivalent ways of counting complete carry paths agree. -/
theorem carryDPCount_eq_carryMatrixCount
    (key diff target : Fin 8 → Fin 16) :
    carryDPCount key diff target =
      carryMatrixCount key diff target := by
  simp only [carryDPCount, carryMatrixCount, carryDP_eq_matrixRow]

-- This is the semantic first half of the 32-bit XOR-DDT / carry-matrix bridge.
-- It proves exact equivalence between the XOR differential of the actual
-- round function and eight local S-box differences. It ALSO defines a
-- carry-path predicate ready for the remaining carry-propagation proof.
-- It does NOT claim that the carry-path count equals the matrix count yet.

/-- Extraction of a nibble commutes with bitwise XOR. -/
private theorem nibble_xor_bridge (u v : V 32) (i : Fin 8) :
    nibble (xor u v) i = xor (nibble u i) (nibble v i) := by
  change
    BitVec.extractLsb' (4 * i.val) 4 (u ^^^ v) =
      BitVec.extractLsb' (4 * i.val) 4 u ^^^
      BitVec.extractLsb' (4 * i.val) 4 v
  exact BitVec.extractLsb'_xor

/--
  Standard (XOR-input / XOR-output) DDT entry of the *actual* round
  function `g k`. Unlike `addXorDDT`, the input difference is XOR.
-/
def xorDDT_g (k d out : V 32) : Nat :=
  ((Finset.univ : Finset (V 32)).filter (fun x =>
    xor (g k (xor x d)) (g k x) = out)).card

/-- At zero key the XOR-DDT of g is exactly the DDT of t,
    with the output rotated. The proof compares predicates and does NOT
    enumerate Finset.univ of the 32-bit word type. -/
theorem xorDDT_g_zero_key_eq_ddtT (d out : V 32) :
    xorDDT_g (0#32) d (rot11 out) = TProperties.ddtT d out := by
  unfold xorDDT_g TProperties.ddtT
  apply congrArg Finset.card
  ext x
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  simp only [g_as_modShift, modShift_zero_key, rot11_xor]
  constructor
  · intro h
    exact rot11_is_bijective.injective h
  · intro h
    exact congrArg rot11 h

/--
  An equivalent, nibble-local specification of the XOR-DDT of `g`.
  Both inputs to each S-box are obtained from the *complete* modular
  additions, so this definition retains carry propagation exactly.
  The unrotated output difference is used here.
-/
def xorDDT_g_nibbles (k d out : V 32) : Nat :=
  ((Finset.univ : Finset (V 32)).filter (fun x =>
    ∀ i : Fin 8,
      xor (π i (nibble (modShift k (xor x d)) i))
          (π i (nibble (modShift k x) i)) = nibble out i)).card

/--
  The XOR difference of `g[k]` is `rot11 out` iff all eight unrotated
  S-box output nibbles have difference given by `out`.

  This follows from the existing specification of `g`, the fact that
  rotation preserves XOR, and `t_substitutes_components`. In particular,
  it does not assume independence of carries between adjacent nibbles.
-/
theorem g_xor_difference_iff_nibbles
    (k d out x : V 32) :
    (xor (g k (xor x d)) (g k x) = rot11 out) ↔
      ∀ i : Fin 8,
        xor (π i (nibble (modShift k (xor x d)) i))
            (π i (nibble (modShift k x) i)) = nibble out i := by
  have hrot :
      xor (g k (xor x d)) (g k x) =
        rot11 (xor (t (modShift k (xor x d)))
                   (t (modShift k x))) := by
    rw [g_as_modShift k (xor x d), g_as_modShift k x]
    exact rot11_xor _ _
  constructor
  · intro h i
    rw [hrot] at h
    have hinner :
        xor (t (modShift k (xor x d)))
            (t (modShift k x)) = out :=
      rot11_is_bijective.injective h
    have hi := congrArg (fun z : V 32 => nibble z i) hinner
    simpa only [nibble_xor_bridge, t_substitutes_components] using hi
  · intro h
    have hinner :
        xor (t (modShift k (xor x d)))
            (t (modShift k x)) = out := by
      apply nibble_ext
      intro i
      simpa only [nibble_xor_bridge, t_substitutes_components] using h i
    rw [hrot, hinner]

/--
  Exact semantic reduction of the 32-bit XOR-DDT of `g[k]` to eight
  local S-box output-difference equations. This is still a symbolic
  count over 32-bit inputs; it is *not* the four-state DP theorem.
-/
theorem xorDDT_g_eq_nibbles (k d out : V 32) :
    xorDDT_g k d (rot11 out) = xorDDT_g_nibbles k d out := by
  unfold xorDDT_g xorDDT_g_nibbles
  apply congrArg Finset.card
  ext x
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  exact g_xor_difference_iff_nibbles k d out x

/-- Split a 32-bit word into its eight four-bit numerical digits. -/
def wordDigits (x : V 32) : Fin 8 → Fin 16 :=
  fun i => (nibble x i).toFin

/-- At zero key, the exact 32-bit XOR-DDT factorizes over the eight
    genuine RFC 8891 nibble substitution DDTs. -/
theorem xorDDT_g_zero_key_factor (d out : V 32) :
    xorDDT_g (0#32) d (rot11 out) =
      ∏ i : Fin 8,
        SBoxProperties.ddt i (wordDigits d i) (wordDigits out i) := by
  rw [xorDDT_g_zero_key_eq_ddtT, TProperties.ddtT_factor]
  rfl

/--
  Follow the two carry chains over eight digits. The Boolean component
  records whether every substituted output nibble matches the target.
  The final carry state is intentionally unrestricted (modulo 2^32).
-/
def carryTrace (key diff target input : Fin 8 → Fin 16) :
    CarryState × Bool :=
  Fin.foldl 8
    (fun acc i =>
      let step := sboxCarryStep i (key i) (diff i) (input i) acc.1
      (step.2, acc.2 && decide (step.1 = target i)))
    (((0, 0) : CarryState), true)

/-- The carry automaton accepts an eight-nibble input assignment. -/
def carryAccept (key diff target input : Fin 8 → Fin 16) : Prop :=
  (carryTrace key diff target input).2 = true

/--
  Counts the 32-bit inputs accepted by the eight-step
  carry automaton.

  The acceptance condition is expressed directly as a
  Boolean equality, providing a computable DecidablePred.
-/
def carryWordCount (k d out : V 32) : Nat :=
  ((Finset.univ : Finset (V 32)).filter (fun x =>
    (carryTrace
      (wordDigits k)
      (wordDigits d)
      (wordDigits out)
      (wordDigits x)).2 = true)).card

theorem carryAccept_iff_trace (key diff target input : Fin 8 → Fin 16) :
    carryAccept key diff target input ↔ (carryTrace key diff target input).2 = true := by rfl

/-- Interpret one element of Fin 16 as a four-bit nibble. -/
private def digitVec (d : Fin 16) : V 4 := BitVec.ofFin d

/-- Pack eight little-endian-indexed digits into a 32-bit word. -/
def packDigits (d : Fin 8 → Fin 16) : V 32 :=
  digitVec (d 7) ++ digitVec (d 6) ++ digitVec (d 5) ++
  digitVec (d 4) ++ digitVec (d 3) ++ digitVec (d 2) ++
  digitVec (d 1) ++ digitVec (d 0)

/-- Every digit is recovered after packing. -/
private theorem wordDigits_packDigits
    (d : Fin 8 → Fin 16) (i : Fin 8) :
    wordDigits (packDigits d) i = d i := by
  change (nibble (packDigits d) i).toFin = d i
  unfold packDigits
  rw [nibble_concat]
  fin_cases i <;> simp [digitVec]

/-- Packing the digits of a word recovers the original word. -/
private theorem packDigits_wordDigits (x : V 32) :
    packDigits (wordDigits x) = x := by
  apply nibble_ext
  intro i
  apply BitVec.eq_of_toFin_eq
  change wordDigits (packDigits (wordDigits x)) i = wordDigits x i
  exact wordDigits_packDigits (wordDigits x) i

/-- A 32-bit word is equivalent to eight independent Fin 16 digits. -/
def wordDigitsEquiv : V 32 ≃ (Fin 8 → Fin 16) where
  toFun := wordDigits
  invFun := packDigits
  left_inv := packDigits_wordDigits
  right_inv := by
    intro d
    funext i
    exact wordDigits_packDigits d i

/-- Taking digits commutes with a 32-bit XOR. -/
theorem wordDigits_xor (u v : V 32) (i : Fin 8) :
    wordDigits (xor u v) i =
      xorDigit (wordDigits u i) (wordDigits v i) := by
  unfold wordDigits xorDigit
  rw [nibble_xor_bridge]
  change ((nibble u i) ^^^ (nibble v i)).toFin =
    ((BitVec.ofNat 4 (nibble u i).toNat) ^^^
      (BitVec.ofNat 4 (nibble v i).toNat)).toFin
  simp only [BitVec.ofNat_toNat, BitVec.setWidth_eq]

/--
  Reindex the accepted-input count from 32-bit words to their
  eight digit assignments. This is a structural equality of
  finite cardinalities, NOT an enumeration of 2^32 inputs.
-/
theorem carryWordCount_eq_digitAssignments (k d out : V 32) :
    carryWordCount k d out =
      ((Finset.univ : Finset (Fin 8 → Fin 16)).filter (fun digits =>
        (carryTrace (wordDigits k) (wordDigits d)
          (wordDigits out) digits).2 = true)).card := by
  unfold carryWordCount
  refine Finset.card_equiv wordDigitsEquiv ?_
  intro x
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  rfl

-- inductive counting carrying paths

/-- A local transition count is the sum of the indicators of its
    sixteen possible input digits. This is an exact combinatorial
    identity, not an evaluation of the 32-bit input space. -/
theorem sboxTransitionCount_eq_indicator_sum
    (i : Fin 8) (k d b : Fin 16) (s t : CarryState) :
    sboxTransitionCount i k d b s t =
      ∑ x : Fin 16,
        if sboxCarryStep i k d x s = (b, t) then (1 : Nat) else 0 := by
  unfold sboxTransitionCount
  rw [Finset.card_filter]

/-- The row-vector transition is a weighted sum of all local
    input digits and all possible incoming carry states.

    The input digit is *not* treated as independent of its
    incoming state. Its effect is computed by `sboxCarryStep`. -/
theorem vecMul_carryMatrix_eq_double_sum
    (i : Fin 8) (k d b : Fin 16)
    (row : CarryState → Nat) (t : CarryState) :
    Matrix.vecMul row (carryMatrix i k d b) t =
      ∑ s : CarryState, ∑ x : Fin 16,
        row s *
          (if sboxCarryStep i k d x s = (b, t) then (1 : Nat) else 0) := by
  rw [Matrix.vecMul_apply_eq_sum]
  simp only [carryMatrix_apply, sboxTransitionCount_eq_indicator_sum]
  simp_rw [Finset.mul_sum]

/-- The same local transition with the digit sum outermost.
    This order will be useful when splitting a complete input
    assignment into a prefix and its last digit. -/
theorem vecMul_carryMatrix_eq_sum_inputs
    (i : Fin 8) (k d b : Fin 16)
    (row : CarryState → Nat) (t : CarryState) :
    Matrix.vecMul row (carryMatrix i k d b) t =
      ∑ x : Fin 16, ∑ s : CarryState,
        row s *
          (if sboxCarryStep i k d x s = (b, t) then (1 : Nat) else 0) := by
  rw [vecMul_carryMatrix_eq_double_sum]
  rw [Finset.sum_comm]

/-- The DP row immediately before the final (most significant)
    nibble has been processed. -/
def carryPrefix7 (key diff target : Fin 8 → Fin 16) :
    CarryState → Nat :=
  Fin.foldl 7
    (fun row (i : Fin 7) =>
      Matrix.vecMul row
        (carryMatrix i.castSucc
          (key i.castSucc) (diff i.castSucc) (target i.castSucc)))
    initialRow

/-- The eight-step DP is exactly one final transfer applied to
    the seven-step prefix. -/
theorem carryDP_eq_last_step (key diff target : Fin 8 → Fin 16) :
    carryDP key diff target =
      Matrix.vecMul (carryPrefix7 key diff target)
        (carryMatrix 7 (key 7) (diff 7) (target 7)) := by
  unfold carryDP carryPrefix7
  rw [Fin.foldl_succ_last]
  rfl

/-- One concrete instance of the finite-state path-counting
    recurrence: the last nibble is accounted for by summing over
    every last input digit and every incoming carry state.

    The final carry state remains unrestricted, as required for
    addition modulo 2^32. -/
theorem carryDPCount_eq_last_digit_sum
    (key diff target : Fin 8 → Fin 16) :
    carryDPCount key diff target =
      ∑ t : CarryState, ∑ x : Fin 16, ∑ s : CarryState,
        carryPrefix7 key diff target s *
          (if sboxCarryStep 7 (key 7) (diff 7) x s =
                (target 7, t) then (1 : Nat) else 0) := by
  unfold carryDPCount
  rw [carryDP_eq_last_step]
  simp only [vecMul_carryMatrix_eq_sum_inputs]

/-- The semantic carry trace restricted to the seven least-significant
    digits; its result is a carry pair and an acceptance flag. -/
def carryTracePrefix7
    (key diff target input : Fin 8 → Fin 16) : CarryState × Bool :=
  Fin.foldl 7
    (fun acc (i : Fin 7) =>
      let step := sboxCarryStep i.castSucc
        (key i.castSucc) (diff i.castSucc) (input i.castSucc) acc.1
      (step.2, acc.2 && decide (step.1 = target i.castSucc)))
    (((0, 0) : CarryState), true)

/-- The complete trace is the prefix trace followed by the final nibble. -/
theorem carryTrace_eq_last_step
    (key diff target input : Fin 8 → Fin 16) :
    carryTrace key diff target input =
      let _prefix := carryTracePrefix7 key diff target input
      let step := sboxCarryStep 7 (key 7) (diff 7) (input 7) _prefix.1
      (step.2, _prefix.2 && decide (step.1 = target 7)) := by
  unfold carryTrace carryTracePrefix7
  rw [Fin.foldl_succ_last]
  rfl

/-- Acceptance of the full trace is equivalent to acceptance of
    the seven-digit prefix AND satisfaction of the last local
    output-difference constraint. The outgoing final carry is free. -/
theorem carryAccept_iff_prefix_and_last
    (key diff target input : Fin 8 → Fin 16) :
    carryAccept key diff target input ↔
      (carryTracePrefix7 key diff target input).2 = true ∧
      (sboxCarryStep 7 (key 7) (diff 7) (input 7)
        (carryTracePrefix7 key diff target input).1).1 = target 7 := by
  unfold carryAccept
  rw [carryTrace_eq_last_step]
  simp only [Bool.and_eq_true, decide_eq_true_eq]

--
-- The purpose of these statements is to set up the *general n-step induction*.
-- It does NOT yet claim carryWordCount = carryDPCount.

/-- One deterministic digit step: the output is the next carry state
    and a Boolean recording whether the required local difference holds. -/
private abbrev AcceptedStep (n : Nat) :=
  Fin n → Fin 16 → CarryState → CarryState × Bool

/-- An arbitrary-length version of the existing eight-digit `carryTrace`.
    The second component is true iff all local tests have succeeded. -/
def tracePrefixN (n : Nat) (step : AcceptedStep n)
    (input : Fin n → Fin 16) (start : CarryState) : CarryState × Bool :=
  Fin.foldl n
    (fun acc i =>
      let next := step i (input i) acc.1
      (next.1, acc.2 && next.2))
    (start, true)

/-- Separating the final digit in a deterministic carry trace.
    This is the general-n form of `carryTrace_eq_last_step`. -/
theorem tracePrefixN_snoc (n : Nat)
    (step : AcceptedStep (n + 1))
    (input : Fin n → Fin 16) (lastDigit : Fin 16)
    (start : CarryState) :
    tracePrefixN (n + 1) step (Fin.snoc input lastDigit) start =
      let _prefix := tracePrefixN n (fun i => step i.castSucc) input start
      let next := step (Fin.last n) lastDigit _prefix.1
      (next.1, _prefix.2 && next.2) := by
  unfold tracePrefixN
  rw [Fin.foldl_succ_last]
  simp only [Fin.snoc_castSucc, Fin.snoc_last]

/-- Structural reindexing of an (n+1)-digit sum into its n-digit
    prefix and last digit. This rearranges a finite sum symbolically;
    it does not enumerate all 16^(n+1) assignments. -/
theorem sum_digitAssignments_snoc (n : Nat)
    (f : (Fin (n + 1) → Fin 16) → Nat) :
    (∑ input : Fin (n + 1) → Fin 16, f input) =
      ∑ _prefix : Fin n → Fin 16, ∑ x : Fin 16, f (Fin.snoc _prefix x) := by
  calc
    (∑ input : Fin (n + 1) → Fin 16, f input) =
        ∑ z : Fin 16 × (Fin n → Fin 16), f (Fin.snoc z.2 z.1) := by
          simpa only [Fin.snocEquiv_apply] using
            (Equiv.sum_comp
              (Fin.snocEquiv (fun _ : Fin (n + 1) => Fin 16)) f).symm
    _ = ∑ x : Fin 16, ∑ _prefix : Fin n → Fin 16,
          f (Fin.snoc _prefix x) := by
            rw [Fintype.sum_prod_type]
    _ = ∑ _prefix : Fin n → Fin 16, ∑ x : Fin 16,
          f (Fin.snoc _prefix x) := Finset.sum_comm

/-- Distribution of accepted n-digit inputs over their final state.
    Unlike `tracePrefixN`, this expression is a mathematical count;
    it is not meant to be evaluated for n = 8. -/
def traceDistributionN (n : Nat) (step : AcceptedStep n)
    (start : CarryState) (finalState : CarryState) : Nat :=
  ∑ input : Fin n → Fin 16,
    if tracePrefixN n step input start = (finalState, true) then 1 else 0

/-- The exact last-digit recurrence of the trace distribution.
    It is the left-hand side of the forthcoming DP invariant. -/
theorem traceDistributionN_succ (n : Nat)
    (step : AcceptedStep (n + 1))
    (start finalState : CarryState) :
    traceDistributionN (n + 1) step start finalState =
      ∑ _prefix : Fin n → Fin 16, ∑ x : Fin 16,
        let prev := tracePrefixN n (fun i => step i.castSucc) _prefix start
        let next := step (Fin.last n) x prev.1
        if (next.1, prev.2 && next.2) = (finalState, true)
          then 1 else 0 := by
  unfold traceDistributionN
  rw [sum_digitAssignments_snoc]
  simp only [tracePrefixN_snoc]

/-- A transition matrix for an arbitrary deterministic digit step.
    Its entries count the sixteen possible local inputs. -/
def acceptedStepMatrix {n : Nat} (step : AcceptedStep n) (i : Fin n) :
    Matrix CarryState CarryState Nat :=
  Matrix.of (fun s t =>
    ∑ x : Fin 16,
      if step i x s = (t, true) then 1 else 0)

/-- General-n dynamic programming for the same deterministic step. -/
def carryDPN (n : Nat) (step : AcceptedStep n) (start : CarryState) :
    CarryState → Nat :=
  Fin.foldl n
    (fun row i => Matrix.vecMul row (acceptedStepMatrix step i))
    (Pi.single start 1)

/-- The DP recurrence, matching `traceDistributionN_succ` on the other
    side of the prospective induction. -/
theorem carryDPN_succ (n : Nat)
    (step : AcceptedStep (n + 1)) (start : CarryState) :
    carryDPN (n + 1) step start =
      Matrix.vecMul (carryDPN n (fun i => step i.castSucc) start)
        (acceptedStepMatrix step (Fin.last n)) := by
  unfold carryDPN
  rw [Fin.foldl_succ_last]
  rfl

/-- The step induced by one RFC 8891 S-box and the associated two
    carry chains. It can be plugged into `tracePrefixN` and `carryDPN`. -/
def magmaAcceptedStep
    (key diff target : Fin 8 → Fin 16) : AcceptedStep 8 :=
  fun i x state =>
    let result := sboxCarryStep i (key i) (diff i) x state
    (result.2, decide (result.1 = target i))

/-- The abstract eight-digit trace is definitionally the previously
    verified semantic carry trace. -/
theorem tracePrefixN_eight
    (key diff target input : Fin 8 → Fin 16) :
    tracePrefixN 8 (magmaAcceptedStep key diff target) input (0, 0) =
      carryTrace key diff target input := by
  rfl

----- Now we prove it.

/-- A finite Kronecker delta selects the coefficient at its support. -/
private theorem sum_single_indicator
    (s : CarryState) (f : CarryState → Nat) :
    (∑ u : CarryState, (if s = u then 1 else 0) * f u) = f s := by
  calc
    (∑ u : CarryState, (if s = u then 1 else 0) * f u) =
        ∑ u : CarryState, if s = u then f u else 0 := by
          apply Finset.sum_congr rfl
          intro u _
          split_ifs <;> simp
    _ = f s := by
      simp

/-- An accepted extended prefix must have an accepted prefix and
    a successful final transition. The unique prefix carry state is
    selected by a finite Kronecker delta. -/
private theorem accepted_step_indicator
    (prev : CarryState × Bool)
    (next : CarryState → CarryState × Bool)
    (finalState : CarryState) :
    (if ((next prev.1).1, prev.2 && (next prev.1).2) =
         (finalState, true) then (1 : Nat) else 0) =
      ∑ s : CarryState,
        (if prev = (s, true) then 1 else 0) *
        (if next s = (finalState, true) then 1 else 0) := by
  rcases prev with ⟨s, ok⟩
  cases ok with
  | false =>
      simp
  | true =>
      simpa [Prod.mk.injEq, Bool.true_and] using
        (sum_single_indicator s
          (fun u : CarryState =>
            if next u = (finalState, true) then (1 : Nat) else 0)).symm

/-- The exact semantic prefix distribution obeys the same matrix
    recurrence as the formal DP, for an *arbitrary* deterministic
    digit transducer and any prefix length. -/

theorem traceDistributionN_succ_as_vecMul (n : Nat)
    (step : AcceptedStep (n + 1))
    (start finalState : CarryState) :
    traceDistributionN (n + 1) step start finalState =
      Matrix.vecMul
        (traceDistributionN n (fun i => step i.castSucc) start)
        (acceptedStepMatrix step (Fin.last n)) finalState := by
  let weight : (Fin n → Fin 16) → Fin 16 → CarryState → Nat :=
    fun _prefix x s =>
      (if tracePrefixN n (fun i => step i.castSucc) _prefix start =
            (s, true) then 1 else 0) *
      (if step (Fin.last n) x s = (finalState, true) then 1 else 0)

  have hsem :
      traceDistributionN (n + 1) step start finalState =
        ∑ _prefix : Fin n → Fin 16, ∑ x : Fin 16,
          ∑ s : CarryState, weight _prefix x s := by
    rw [traceDistributionN_succ]
    apply Finset.sum_congr rfl
    intro _prefix _
    apply Finset.sum_congr rfl
    intro x _
    simpa only [weight] using
      (accepted_step_indicator
        (tracePrefixN n (fun i => step i.castSucc) _prefix start)
        (fun s => step (Fin.last n) x s) finalState)

  have hdp :
      Matrix.vecMul
          (traceDistributionN n (fun i => step i.castSucc) start)
          (acceptedStepMatrix step (Fin.last n)) finalState =
        ∑ s : CarryState, ∑ _prefix : Fin n → Fin 16,
          ∑ x : Fin 16, weight _prefix x s := by
    rw [Matrix.vecMul_apply_eq_sum]
    apply Finset.sum_congr rfl
    intro s _
    simp only [traceDistributionN, acceptedStepMatrix, Matrix.of_apply]
    rw [Fintype.sum_mul_sum]

  calc
    traceDistributionN (n + 1) step start finalState =
        ∑ _prefix : Fin n → Fin 16, ∑ x : Fin 16,
          ∑ s : CarryState, weight _prefix x s := hsem
    _ = ∑ _prefix : Fin n → Fin 16, ∑ s : CarryState,
          ∑ x : Fin 16, weight _prefix x s := by
          apply Finset.sum_congr rfl
          intro _prefix _
          rw [Finset.sum_comm]
    _ = ∑ s : CarryState, ∑ _prefix : Fin n → Fin 16,
          ∑ x : Fin 16, weight _prefix x s := Finset.sum_comm
    _ = Matrix.vecMul
          (traceDistributionN n (fun i => step i.castSucc) start)
          (acceptedStepMatrix step (Fin.last n)) finalState := hdp.symm

set_option diagnostics false

/-- **Main prefix invariant.** At every length n, the distribution
    over final carry states obtained by counting accepted digit strings
    agrees with the row computed by dynamic programming.

    The proof is parametric in the transition function; no properties
    specific to RFC 8891 are needed. -/
theorem traceDistributionN_eq_carryDPN :
    ∀ (n : Nat) (step : AcceptedStep n)
      (start finalState : CarryState),
      traceDistributionN n step start finalState =
        carryDPN n step start finalState := by
  intro n
  induction n with
  | zero =>
      intro step start finalState

      let emptyDigits : Fin 0 → Fin 16 :=
        fun i => i.elim0

      have : Subsingleton (Fin 0 → Fin 16) :=
        ⟨by
          intro f g
          funext i
          exact i.elim0⟩

      calc
        traceDistributionN 0 step start finalState =
            (if tracePrefixN 0 step emptyDigits start =
                  (finalState, true)
              then (1 : Nat) else 0) := by
          unfold traceDistributionN
          exact Fintype.sum_subsingleton
            (fun input : Fin 0 → Fin 16 =>
              if tracePrefixN 0 step input start =
                    (finalState, true)
              then (1 : Nat) else 0)
            emptyDigits

        _ = carryDPN 0 step start finalState := by
          simp [tracePrefixN, carryDPN, Pi.single_apply, eq_comm]

  | succ n ih =>
      intro step start finalState
      rw [traceDistributionN_succ_as_vecMul, carryDPN_succ]
      simp only [Matrix.vecMul_apply_eq_sum]
      apply Finset.sum_congr rfl
      intro s _
      rw [ih (fun i => step i.castSucc) start s]

/-- The abstract accepted-step matrix is exactly the previously
    verified S-box/carry matrix for RFC 8891. -/
theorem acceptedStepMatrix_magma
    (key diff target : Fin 8 → Fin 16) (i : Fin 8) :
    acceptedStepMatrix (magmaAcceptedStep key diff target) i =
      carryMatrix i (key i) (diff i) (target i) := by
  ext s t
  simp only [acceptedStepMatrix, Matrix.of_apply,
    carryMatrix_apply, sboxTransitionCount_eq_indicator_sum]
  apply Finset.sum_congr rfl
  intro x _
  rcases hr : sboxCarryStep i (key i) (diff i) x s with
    ⟨y, newState⟩
  by_cases h : y = target i
  · simp [magmaAcceptedStep, hr, h, Prod.mk.injEq, and_comm]
  · simp [magmaAcceptedStep, hr, h, Prod.mk.injEq, and_comm]

/-- The general eight-step DP is the existing Magma DP. -/
theorem carryDPN_magma_eq_carryDP
    (key diff target : Fin 8 → Fin 16) :
    carryDPN 8 (magmaAcceptedStep key diff target) (0, 0) =
      carryDP key diff target := by
  unfold carryDPN carryDP initialRow
  simp only [acceptedStepMatrix_magma]

/-- Summing the terminal-state indicators removes the terminal carry
    restriction; carries past the top nibble are intentionally ignored. -/
private theorem sum_final_indicator (p : CarryState × Bool) :
    (if p.2 = true then (1 : Nat) else 0) =
      ∑ s : CarryState, if p = (s, true) then 1 else 0 := by
  rcases p with ⟨s, ok⟩
  cases ok <;> simp [Prod.mk.injEq]

/-- Counting accepted 32-bit words is equivalent to summing
    the eight-step trace distributions over the terminal states. -/
theorem carryWordCount_eq_traceDistribution (k d out : V 32) :
    carryWordCount k d out =
      ∑ s : CarryState,
        traceDistributionN 8
          (magmaAcceptedStep (wordDigits k) (wordDigits d)
            (wordDigits out)) (0, 0) s := by
  rw [carryWordCount_eq_digitAssignments]
  rw [Finset.card_filter]
  unfold traceDistributionN
  simp only [tracePrefixN_eight]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro input _
  exact sum_final_indicator
    (carryTrace (wordDigits k) (wordDigits d) (wordDigits out) input)

/-- **Eight-nibble counting theorem.** Exactly as many input words
    are accepted by the real carry trace as are counted by the
    four-state dynamic program; the 2^32 inputs are never evaluated. -/
theorem carryWordCount_eq_carryDPCount (k d out : V 32) :
    carryWordCount k d out =
      carryDPCount (wordDigits k) (wordDigits d) (wordDigits out) := by
  calc
    carryWordCount k d out =
        ∑ s : CarryState,
          traceDistributionN 8
            (magmaAcceptedStep (wordDigits k) (wordDigits d)
              (wordDigits out)) (0, 0) s :=
      carryWordCount_eq_traceDistribution k d out
    _ = ∑ s : CarryState,
          carryDPN 8
            (magmaAcceptedStep (wordDigits k) (wordDigits d)
              (wordDigits out)) (0, 0) s := by
          apply Finset.sum_congr rfl
          intro s _
          exact traceDistributionN_eq_carryDPN 8 _ _ s
    _ = carryDPCount (wordDigits k) (wordDigits d)
          (wordDigits out) := by
          simp only [carryDPCount, carryDPN_magma_eq_carryDP]

/-- Final combinatorial link to the ordered 4×4 matrix product.
    A further arithmetic-semantic bridge is still needed to identify
    `carryWordCount` with the XOR-DDT of the actual function `g`. -/
theorem carryWordCount_eq_carryMatrixCount (k d out : V 32) :
    carryWordCount k d out =
      carryMatrixCount (wordDigits k) (wordDigits d) (wordDigits out) := by
  exact (carryWordCount_eq_carryDPCount k d out).trans
    (carryDPCount_eq_carryMatrixCount _ _ _)

-- This is the arithmetic core of the remaining semantic bridge.

/-- Value of the first `n` digits in base 16, least significant first.
    The domain is `Nat → Fin 16` so induction does not require index casts. -/
def digitPrefixValue (ds : Nat → Fin 16) : Nat → Nat
  | 0 => 0
  | n + 1 => digitPrefixValue ds n + (ds n).val * 16 ^ n

/-- The incoming carry into digit `n` during addition of two streams. -/
def incomingCarry (xs ks : Nat → Fin 16) : Nat → Fin 2
  | 0 => 0
  | n + 1 => nextCarry (xs n) (ks n) (incomingCarry xs ks n)

/-- The corresponding output digits of base-16 addition. -/
def addedDigits (xs ks : Nat → Fin 16) : Nat → Fin 16 :=
  fun n => outputDigit (xs n) (ks n) (incomingCarry xs ks n)

/-- Each prefix represents a number strictly below 16^n. -/
theorem digitPrefixValue_lt (ds : Nat → Fin 16) (n : Nat) :
    digitPrefixValue ds n < 16 ^ n := by
  induction n with
  | zero => simp [digitPrefixValue]
  | succ n ih =>
      change digitPrefixValue ds n + (ds n).val * 16 ^ n < 16 ^ (n + 1)
      rw [pow_succ]
      have hd : (ds n).val ≤ 15 := by
        have := (ds n).isLt
        omega
      have hbound : (ds n).val * 16 ^ n ≤ 15 * (16 ^ n) :=
        Nat.mul_le_mul_right _ hd
      omega

/-- The fundamental positional-carry invariant.

    The sum of the input prefixes equals the prefix of output digits
    plus 16^n times the outgoing carry.  This holds for *all* n,
    independently of Magma and its S-boxes. -/
theorem digitPrefixValue_add_carry (xs ks : Nat → Fin 16) (n : Nat) :
    digitPrefixValue xs n + digitPrefixValue ks n =
      digitPrefixValue (addedDigits xs ks) n +
        16 ^ n * (incomingCarry xs ks n).val := by
  induction n with
  | zero =>
      simp [digitPrefixValue, incomingCarry]
  | succ n ih =>
      have hstep := addStep_correct (xs n) (ks n) (incomingCarry xs ks n)
      have hscaled := congrArg (fun z : Nat => z * 16 ^ n) hstep
      change
        (digitPrefixValue xs n + (xs n).val * 16 ^ n) +
          (digitPrefixValue ks n + (ks n).val * 16 ^ n) =
        (digitPrefixValue (addedDigits xs ks) n +
          (outputDigit (xs n) (ks n) (incomingCarry xs ks n)).val * 16 ^ n) +
          16 ^ (n + 1) *
            (nextCarry (xs n) (ks n) (incomingCarry xs ks n)).val
      rw [pow_succ]
      nlinarith [ih, hscaled]

/-- The output digits are exactly the low n base-16 digits of the sum.
    This is the key arithmetic fact needed for modulo-2^32 addition. -/
theorem digitPrefixValue_addedDigits_mod (xs ks : Nat → Fin 16) (n : Nat) :
    digitPrefixValue (addedDigits xs ks) n =
      (digitPrefixValue xs n + digitPrefixValue ks n) % 16 ^ n := by
  have hlt := digitPrefixValue_lt (addedDigits xs ks) n
  have h := digitPrefixValue_add_carry xs ks n
  rw [h]
  rw [Nat.mul_comm (16 ^ n) (incomingCarry xs ks n).val]
  rw [Nat.add_mul_mod_self_right]
  exact (Nat.mod_eq_of_lt hlt).symm

/-- The recursively defined carry agrees with an ordered finite fold.
    Later we will instantiate this with the eight nibbles of a BitVec. -/
theorem incomingCarry_eq_fold (xs ks : Nat → Fin 16) (n : Nat) :
    incomingCarry xs ks n =
      Fin.foldl n
        (fun c i => nextCarry (xs i.val) (ks i.val) c)
        (0 : Fin 2) := by
  induction n with
  | zero => simp [incomingCarry, Fin.foldl_zero]
  | succ n ih =>
      rw [Fin.foldl_succ_last]
      change
        nextCarry (xs n) (ks n) (incomingCarry xs ks n) =
          nextCarry (xs n) (ks n)
            (Fin.foldl n
              (fun c i => nextCarry (xs i.val) (ks i.val) c)
              (0 : Fin 2))
      rw [ih]

/-- Final reduction once the pointwise arithmetic correspondence between
    `carryTrace` and the S-box equations has been proved.

    This theorem is explicitly *conditional*: it packages the last step
    without pretending the missing correspondence has already been shown. -/
theorem xorDDT_g_eq_carryMatrixCount_of_semantics
    (k d out : V 32)
    (hsem : ∀ x : V 32,
      (∀ i : Fin 8,
        xor (π i (nibble (modShift k (xor x d)) i))
            (π i (nibble (modShift k x) i)) = nibble out i) ↔
      (carryTrace (wordDigits k) (wordDigits d)
        (wordDigits out) (wordDigits x)).2 = true) :
    xorDDT_g k d (rot11 out) =
      carryMatrixCount (wordDigits k) (wordDigits d) (wordDigits out) := by
  rw [xorDDT_g_eq_nibbles]
  have hcount : xorDDT_g_nibbles k d out = carryWordCount k d out := by
    unfold xorDDT_g_nibbles carryWordCount
    apply congrArg Finset.card
    ext x
    simpa only [Finset.mem_filter, Finset.mem_univ, true_and]
      using hsem x
  exact hcount.trans (carryWordCount_eq_carryMatrixCount k d out)

--- carry bridge

/-- Extracting a nibble numerically is division by 16^i, then modulo 16. -/
theorem wordDigits_val (w : V 32) (i : Fin 8) :
    (wordDigits w i).val = w.toNat / 16 ^ i.val % 16 := by
  change (BitVec.extractLsb' (4 * i.val) 4 w).toNat =
    w.toNat / 16 ^ i.val % 16
  rw [BitVec.extractLsb'_toNat, Nat.shiftRight_eq_div_pow]
  have hp : 2 ^ (4 * i.val) = 16 ^ i.val := by
    rw [pow_mul]
    norm_num
  rw [hp]

/-- The original modular translation is addition of 32-bit unsigned values. -/
theorem modShift_toNat_bridge (k x : V 32) :
    (modShift k x).toNat = (x.toNat + k.toNat) % 16 ^ 8 := by
  change (BitVec.ofNat 32 ((Int_s 32 x + Int_s 32 k).val)).toNat = _
  rw [BitVec.toNat_ofNat]
  rw [Nat.mod_eq_of_lt (ZMod.val_lt (Int_s 32 x + Int_s 32 k))]
  rw [ZMod.val_add]
  have hx : (Int_s 32 x).val = x.toNat := by
    change ((x.toNat : ZMod (2 ^ 32))).val = x.toNat
    exact ZMod.val_natCast_of_lt x.toFin.isLt
  have hk : (Int_s 32 k).val = k.toNat := by
    change ((k.toNat : ZMod (2 ^ 32))).val = k.toNat
    exact ZMod.val_natCast_of_lt k.toFin.isLt
  rw [hx, hk]
  rw [show 16 ^ 8 = 2 ^ 32 from by decide]

/-- An infinite stream of hexadecimal digits of a 32-bit word.
    Only its first eight entries are needed; later entries are zero. -/
def wordDigitStream (w : V 32) (n : Nat) : Fin 16 :=
  ⟨(w.toNat / 16 ^ n) % 16, Nat.mod_lt _ (by decide)⟩

/-- Agreement of the numeric digit stream with the specified `nibble`. -/
theorem wordDigitStream_at (w : V 32) (i : Fin 8) :
    wordDigitStream w i.val = wordDigits w i := by
  apply Fin.ext
  exact (wordDigits_val w i).symm

/-- The low n numeric digits represent reduction modulo 16^n. -/
theorem digitPrefixValue_wordDigitStream (w : V 32) (n : Nat) :
    digitPrefixValue (wordDigitStream w) n = w.toNat % 16 ^ n := by
  induction n with
  | zero => simp [digitPrefixValue, Nat.mod_one]
  | succ n ih =>
      change digitPrefixValue (wordDigitStream w) n +
        (wordDigitStream w n).val * 16 ^ n =
        w.toNat % 16 ^ (n + 1)
      rw [ih, Nat.mod_pow_succ]
      change w.toNat % 16 ^ n +
        (w.toNat / 16 ^ n % 16) * 16 ^ n =
        w.toNat % 16 ^ n +
        16 ^ n * (w.toNat / 16 ^ n % 16)
      ac_rfl

/-- The addition automaton and modular word addition agree on every
    prefix of at most eight digits. -/
theorem addedDigits_prefix_eq_wordShift (k x : V 32)
    (n : Nat) (hn : n ≤ 8) :
    digitPrefixValue
        (addedDigits (wordDigitStream x) (wordDigitStream k)) n =
      digitPrefixValue (wordDigitStream (modShift k x)) n := by
  rw [digitPrefixValue_addedDigits_mod]
  simp only [digitPrefixValue_wordDigitStream]
  rw [modShift_toNat_bridge]
  rw [Nat.mod_mod_of_dvd (x.toNat + k.toNat) (pow_dvd_pow 16 hn)]
  exact (Nat.add_mod x.toNat k.toNat (16 ^ n)).symm

/-- Equal prefixes at lengths n and n+1 have equal n-th digits. -/
private theorem digit_eq_of_two_prefixes
    (xs ys : Nat → Fin 16) (n : Nat)
    (h₀ : digitPrefixValue xs n = digitPrefixValue ys n)
    (h₁ : digitPrefixValue xs (n + 1) =
      digitPrefixValue ys (n + 1)) : xs n = ys n := by
  have hstep :
      digitPrefixValue xs n + (xs n).val * 16 ^ n =
      digitPrefixValue ys n + (ys n).val * 16 ^ n := by
    simpa only [digitPrefixValue] using h₁
  rw [h₀] at hstep
  have hmul : (xs n).val * 16 ^ n = (ys n).val * 16 ^ n :=
    Nat.add_left_cancel hstep
  apply Fin.ext
  exact Nat.eq_of_mul_eq_mul_right
    (pow_pos (by decide : (0 : Nat) < 16) n) hmul

/-- The n-th produced digit agrees with actual 32-bit modular addition. -/
theorem addedDigits_wordShift_at (k x : V 32) (i : Fin 8) :
    addedDigits (wordDigitStream x) (wordDigitStream k) i.val =
      wordDigitStream (modShift k x) i.val := by
  apply digit_eq_of_two_prefixes
  · exact addedDigits_prefix_eq_wordShift k x i.val (by omega)
  · exact addedDigits_prefix_eq_wordShift k x (i.val + 1) (by omega)

/-- Key bridge: the RFC 8891 modular addition and the carry automaton
    produce the same four-bit digit at each of the eight positions. -/
theorem wordDigits_modShift (k x : V 32) (i : Fin 8) :
    wordDigits (modShift k x) i =
      outputDigit (wordDigits x i) (wordDigits k i)
        (incomingCarry (wordDigitStream x) (wordDigitStream k) i.val) := by
  calc
    wordDigits (modShift k x) i =
        wordDigitStream (modShift k x) i.val :=
      (wordDigitStream_at (modShift k x) i).symm
    _ = addedDigits (wordDigitStream x) (wordDigitStream k) i.val :=
      (addedDigits_wordShift_at k x i).symm
    _ = outputDigit (wordDigits x i) (wordDigits k i)
          (incomingCarry (wordDigitStream x) (wordDigitStream k) i.val) := by
      unfold addedDigits
      rw [wordDigitStream_at x i, wordDigitStream_at k i]

/-- The numeric digit of the parallel substitution is its local S-box output. -/
theorem wordDigits_t (w : V 32) (i : Fin 8) :
    wordDigits (t w) i = (π i (nibble w i)).toFin := by
  unfold wordDigits
  rw [t_substitutes_components]

--- final bridge

/-- The two incoming carries before processing digit `n`.
    The first addition uses `x`; the second uses `x XOR d`. -/
def wordCarryPair (k d x : V 32) (n : Nat) : CarryState :=
  (incomingCarry (wordDigitStream x) (wordDigitStream k) n,
   incomingCarry (wordDigitStream (xor x d)) (wordDigitStream k) n)

/-- The exact (unrotated) S-box output difference at digit `i`. -/
def localSBoxDifference (k d x : V 32) (i : Fin 8) : Fin 16 :=
  xorDigit
    (π i (nibble (modShift k (xor x d)) i)).toFin
    (π i (nibble (modShift k x) i)).toFin

private theorem xorDigit_toFin (u v : V 4) : xorDigit u.toFin v.toFin = (xor u v).toFin := by
  unfold xorDigit
  change ((BitVec.ofNat 4 u.toNat) ^^^ (BitVec.ofNat 4 v.toNat)).toFin = (u ^^^ v).toFin
  simp only [BitVec.ofNat_toNat, BitVec.setWidth_eq]

/-- The digit-level output condition is the original S-box equation. -/
theorem localSBoxDifference_eq_iff (k d out x : V 32) (i : Fin 8) :
    localSBoxDifference k d x i = wordDigits out i ↔
      xor (π i (nibble (modShift k (xor x d)) i))
          (π i (nibble (modShift k x) i)) = nibble out i := by
  unfold localSBoxDifference wordDigits
  rw [xorDigit_toFin]
  constructor
  · exact BitVec.eq_of_toFin_eq
  · intro h
    exact congrArg BitVec.toFin h

/-- A concrete S-box/carry step agrees with both modular additions,
    including the next pair of carries. -/
theorem sboxCarryStep_word_correct (k d x : V 32) (i : Fin 8) :
    sboxCarryStep i (wordDigits k i) (wordDigits d i)
        (wordDigits x i) (wordCarryPair k d x i.val) =
      (localSBoxDifference k d x i, wordCarryPair k d x (i.val + 1)) := by
  have hzero :
      outputDigit (wordDigits x i) (wordDigits k i)
        (incomingCarry (wordDigitStream x) (wordDigitStream k) i.val) =
          (nibble (modShift k x) i).toFin :=
    (wordDigits_modShift k x i).symm
  have hone :
      outputDigit (xorDigit (wordDigits x i) (wordDigits d i))
        (wordDigits k i)
        (incomingCarry (wordDigitStream (xor x d))
          (wordDigitStream k) i.val) =
          (nibble (modShift k (xor x d)) i).toFin := by
    rw [← wordDigits_xor x d i]
    exact (wordDigits_modShift k (xor x d) i).symm
  have hinv (u : V 4) :
      BitVec.ofNat 4 u.toFin.val = u := by
    rw [BitVec.ofNat_finVal, BitVec.ofFin_toFin]
  have hcarry :
      (nextCarry (wordDigits x i) (wordDigits k i)
         (incomingCarry (wordDigitStream x) (wordDigitStream k) i.val),
       nextCarry (xorDigit (wordDigits x i) (wordDigits d i))
         (wordDigits k i)
         (incomingCarry (wordDigitStream (xor x d))
           (wordDigitStream k) i.val)) =
        wordCarryPair k d x (i.val + 1) := by
    unfold wordCarryPair
    change
      (nextCarry (wordDigits x i) (wordDigits k i)
         (incomingCarry (wordDigitStream x) (wordDigitStream k) i.val),
       nextCarry (xorDigit (wordDigits x i) (wordDigits d i))
         (wordDigits k i)
         (incomingCarry (wordDigitStream (xor x d))
           (wordDigitStream k) i.val)) =
      (nextCarry (wordDigitStream x i.val) (wordDigitStream k i.val)
         (incomingCarry (wordDigitStream x) (wordDigitStream k) i.val),
       nextCarry (wordDigitStream (xor x d) i.val)
         (wordDigitStream k i.val)
         (incomingCarry (wordDigitStream (xor x d))
           (wordDigitStream k) i.val))
    rw [wordDigitStream_at x i, wordDigitStream_at k i,
        wordDigitStream_at (xor x d) i, wordDigits_xor x d i]
  dsimp only [sboxCarryStep, localSBoxDifference, wordCarryPair]
  rw [hzero, hone]
  simp only [hinv]
  exact congrArg
    (fun state : CarryState =>
      (xorDigit
        (π i (nibble (modShift k (xor x d)) i)).toFin
        (π i (nibble (modShift k x) i)).toFin, state)) hcarry

/-- A Nat-indexed version of the digit step, useful for a generic
    invariant over `Fin.foldl`. Only indices 0,...,7 are used. -/
private def wordAcceptedStep (k d out x : V 32)
    (j : Nat) (s : CarryState) : CarryState × Bool :=
  if hj : j < 8 then
    let i : Fin 8 := ⟨j, hj⟩
    let p := sboxCarryStep i (wordDigits k i) (wordDigits d i)
      (wordDigits x i) s
    (p.2, decide (p.1 = wordDigits out i))
  else
    (s, true)

private theorem wordAcceptedStep_correct (k d out x : V 32) (i : Fin 8) :
    wordAcceptedStep k d out x i.val (wordCarryPair k d x i.val) =
      (wordCarryPair k d x (i.val + 1),
        decide (localSBoxDifference k d x i = wordDigits out i)) := by
  unfold wordAcceptedStep
  rw [dite_eq_left i.isLt]
  have hi : (⟨i.val, i.isLt⟩ : Fin 8) = i := by
    apply Fin.ext
    rfl
  simp only [hi]
  rw [sboxCarryStep_word_correct]

/-- Generic fold invariant: the first component is the expected state;
    the second is the accumulated conjunction of the local tests. -/
private theorem foldStateAndFlag {S : Type}
    (step : Nat → S → S × Bool) (states : Nat → S) (start : S)
    (hinit : states 0 = start) :
    ∀ n : Nat,
      (∀ j : Nat, j < n → (step j (states j)).1 = states (j + 1)) →
      Fin.foldl n
        (fun acc (i : Fin n) =>
          let r := step i.val acc.1
          (r.1, acc.2 && r.2)) (start, true) =
        (states n,
         Fin.foldl n
           (fun ok (i : Fin n) => ok && (step i.val (states i.val)).2)
           true) := by
  intro n
  induction n with
  | zero =>
      intro _
      simp only [Fin.foldl_zero]
      rw [hinit]
  | succ n ih =>
      intro hnext
      have hpre := ih (by
        intro j hj
        exact hnext j (by omega))
      simp only [Fin.foldl_succ_last, Fin.val_castSucc, Fin.val_last]
      rw [hpre]
      simp only [hnext n (by omega)]

/-- A Boolean conjunction over a fold is true precisely when all its
    local conditions are true. -/
private theorem foldAnd_eq_true_iff (p : Nat → Bool) :
    ∀ n : Nat,
      Fin.foldl n (fun ok (i : Fin n) => ok && p i.val) true = true ↔
      ∀ i : Fin n, p i.val = true := by
  intro n
  induction n with
  | zero => simp only [Fin.foldl_zero, Fin.forall_fin_zero]
  | succ n ih =>
      rw [Fin.foldl_succ_last, Fin.forall_fin_succ']
      simp only [Fin.val_castSucc, Fin.val_last, Bool.and_eq_true, ih]

/-- The eight-step semantic trace is the Nat-indexed fold specialized
    to the S-box/carry transition at each nibble. -/
private theorem carryTrace_eq_wordAcceptedFold (k d out x : V 32) :
    carryTrace (wordDigits k) (wordDigits d)
        (wordDigits out) (wordDigits x) =
      Fin.foldl 8
        (fun acc (i : Fin 8) =>
          let r := wordAcceptedStep k d out x i.val acc.1
          (r.1, acc.2 && r.2))
        (((0, 0) : CarryState), true) := by
  unfold carryTrace
  congr 1
  funext acc i
  simp only [wordAcceptedStep, dite_eq_left i.isLt]

/-- Semantic correctness of the carry trace: it accepts exactly the
    inputs satisfying the eight real S-box output-difference equations. -/
theorem carryTrace_iff_nibbleDifferences (k d out x : V 32) :
    (carryTrace (wordDigits k) (wordDigits d)
       (wordDigits out) (wordDigits x)).2 = true ↔
      ∀ i : Fin 8,
        xor (π i (nibble (modShift k (xor x d)) i))
            (π i (nibble (modShift k x) i)) = nibble out i := by
  have hinitial : wordCarryPair k d x 0 = ((0, 0) : CarryState) := by
    simp [wordCarryPair, incomingCarry]
  have htransition :
      ∀ j : Nat, j < 8 →
        (wordAcceptedStep k d out x j (wordCarryPair k d x j)).1 =
          wordCarryPair k d x (j + 1) := by
    intro j hj
    let i : Fin 8 := ⟨j, hj⟩
    have h := congrArg Prod.fst (wordAcceptedStep_correct k d out x i)
    exact h
  have htrace :=
    foldStateAndFlag (wordAcceptedStep k d out x)
      (wordCarryPair k d x) ((0, 0) : CarryState) hinitial
      8 htransition

  have hflag :
      (carryTrace (wordDigits k) (wordDigits d)
        (wordDigits out) (wordDigits x)).2 =
      Fin.foldl 8
        (fun ok (i : Fin 8) =>
          ok && (wordAcceptedStep k d out x i.val
            (wordCarryPair k d x i.val)).2)
        true := by
    calc
      (carryTrace (wordDigits k) (wordDigits d)
        (wordDigits out) (wordDigits x)).2 =
          (Fin.foldl 8
            (fun acc (i : Fin 8) =>
              let r := wordAcceptedStep k d out x i.val acc.1
              (r.1, acc.2 && r.2))
            (((0, 0) : CarryState), true)).2 :=
        congrArg Prod.snd
          (carryTrace_eq_wordAcceptedFold k d out x)
      _ = Fin.foldl 8
            (fun ok (i : Fin 8) =>
              ok && (wordAcceptedStep k d out x i.val
                (wordCarryPair k d x i.val)).2)
            true := by
        simpa only [Prod.snd] using
          congrArg Prod.snd htrace

  have hall :
      (carryTrace (wordDigits k) (wordDigits d)
        (wordDigits out) (wordDigits x)).2 = true ↔
      ∀ i : Fin 8,
        (wordAcceptedStep k d out x i.val
          (wordCarryPair k d x i.val)).2 = true := by
    rw [hflag]
    exact foldAnd_eq_true_iff
      (fun j : Nat =>
        (wordAcceptedStep k d out x j
          (wordCarryPair k d x j)).2) 8

  constructor
  · intro h i
    have hi := (hall.mp h) i
    rw [wordAcceptedStep_correct k d out x i] at hi
    exact (localSBoxDifference_eq_iff k d out x i).mp
      (by simpa only [Prod.snd, decide_eq_true_eq] using hi)

  · intro h
    apply hall.mpr
    intro i
    rw [wordAcceptedStep_correct k d out x i]
    simpa only [Prod.snd, decide_eq_true_eq] using
      (localSBoxDifference_eq_iff k d out x i).mpr (h i)

/-- Final unconditional exact XOR-DDT formula for the Magma round function.
    No exhaustive enumeration of 2^32 words is performed by this proof. -/
theorem xorDDT_g_eq_carryMatrixCount (k d out : V 32) :
    xorDDT_g k d (rot11 out) =
      carryMatrixCount (wordDigits k) (wordDigits d) (wordDigits out) := by
  apply xorDDT_g_eq_carryMatrixCount_of_semantics
  intro x
  exact (carryTrace_iff_nibbleDifferences k d out x).symm

/-- A matrix-based XOR-DDT for `g[k]` accepting an arbitrary output difference.

    Unlike `xorDDT_g_eq_carryMatrixCount`, the output argument need not
    be explicitly written in rotated form. This is a structural (not
    executable) use of the already proved rotation bijection.
-/
noncomputable def matrixDDT_g (k d b : V 32) : Nat :=
  carryMatrixCount (wordDigits k) (wordDigits d) (wordDigits (unrot11 b))

/-- Every standard XOR-DDT entry of the RFC round function is exactly
    the corresponding four-state carry-matrix count. -/
theorem xorDDT_g_eq_matrixDDT (k d b : V 32) :
    xorDDT_g k d b = matrixDDT_g k d b := by
  unfold matrixDDT_g
  simpa only [rot11_unrot11] using
    (xorDDT_g_eq_carryMatrixCount k d (unrot11 b))

/-- A nonzero local matrix entry has a concrete 4-bit input witness.
    This relates numerical weights to the support of a carry transition. -/
theorem carryMatrix_pos_iff_input
    (i : Fin 8) (k d out : Fin 16)
    (s t : CarryState) :
    0 < carryMatrix i k d out s t ↔
      ∃ x : Fin 16, sboxCarryStep i k d x s = (out, t) := by
  rw [carryMatrix_apply]
  unfold sboxTransitionCount
  rw [Finset.card_pos, Finset.filter_nonempty_iff]
  simp only [Finset.mem_univ, true_and]

/-- A row of a nonnegative transition matrix reaches a state with
    positive weight exactly when some positive predecessor has a
    positive-weight transition to that state. -/
private theorem vecMul_nat_pos_iff
    (row : CarryState → Nat)
    (M : Matrix CarryState CarryState Nat)
    (t : CarryState) :
    0 < Matrix.vecMul row M t ↔
      ∃ s : CarryState, 0 < row s ∧ 0 < M s t := by
  rw [Matrix.vecMul_apply_eq_sum]
  have hsum :
      (0 < ∑ s : CarryState, row s * M s t) ↔
        ∃ s ∈ (Finset.univ : Finset CarryState),
          0 < row s * M s t :=
    Finset.sum_pos_iff_of_nonneg (by
      intro s _
      exact Nat.zero_le _)
  constructor
  · intro hp
    obtain ⟨s, _, hs⟩ := hsum.mp hp
    exact ⟨s, Nat.pos_of_mul_pos_right hs,
      Nat.pos_of_mul_pos_left hs⟩
  · rintro ⟨s, hrow, hM⟩
    exact hsum.mpr ⟨s, Finset.mem_univ _, Nat.mul_pos hrow hM⟩

/-- The total eight-step carry count is positive iff at least one
    final carry state has positive DP weight. -/
theorem carryMatrixCount_pos_iff_finalState
    (key diff target : Fin 8 → Fin 16) :
    0 < carryMatrixCount key diff target ↔
      ∃ s : CarryState, 0 < carryDP key diff target s := by
  rw [← carryDPCount_eq_carryMatrixCount]
  unfold carryDPCount
  have hsum :
      (0 < ∑ s : CarryState, carryDP key diff target s) ↔
        ∃ s ∈ (Finset.univ : Finset CarryState),
          0 < carryDP key diff target s :=
    Finset.sum_pos_iff_of_nonneg (by
      intro s _
      exact Nat.zero_le _)
  simpa only [Finset.mem_univ, true_and] using hsum

/-- Executable four-state feasibility test for the pre-rotation
    output difference of the RFC 8891 round function. -/
def carryHasPath (key diff target : Fin 8 → Fin 16) : Bool :=
  decide (∃ s : CarryState, 0 < carryDP key diff target s)

/-- Boolean feasibility agrees with the positive numerical matrix count. -/
theorem carryHasPath_iff_count_pos
    (key diff target : Fin 8 → Fin 16) :
    carryHasPath key diff target = true ↔
      0 < carryMatrixCount key diff target := by
  simp only [carryHasPath, decide_eq_true_eq]
  exact (carryMatrixCount_pos_iff_finalState key diff target).symm

/-- A feasible path exists exactly when the round function has a
    nonzero XOR-DDT entry for the corresponding rotated difference. -/
theorem carryHasPath_iff_xorDDT_g_pos
    (k d out : V 32) :
    carryHasPath (wordDigits k) (wordDigits d) (wordDigits out) = true ↔
      0 < xorDDT_g k d (rot11 out) := by
  rw [carryHasPath_iff_count_pos]
  rw [xorDDT_g_eq_carryMatrixCount]

/-- A negative support test certifies an impossible fixed-key
    XOR differential of `g[k]`. No 2^32-word enumeration is used. -/
theorem xorDDT_g_eq_zero_of_no_carry_path
    (k d out : V 32)
    (h : carryHasPath (wordDigits k) (wordDigits d)
      (wordDigits out) = false) :
    xorDDT_g k d (rot11 out) = 0 := by
  have hnot : ¬ (0 < xorDDT_g k d (rot11 out)) := by
    intro hp
    have hy := (carryHasPath_iff_xorDDT_g_pos k d out).mpr hp
    simp only [h] at hy
    cases hy
  omega

/-- A computable matrix model for an arbitrary output XOR difference. -/
def matrixDDT_g_fast (k d b : V 32) : Nat :=
  carryMatrixCount (wordDigits k) (wordDigits d)
    (wordDigits (b.rotateRight 11))

/-- The computable and the previously certified matrix models agree. -/
theorem matrixDDT_g_fast_eq (k d b : V 32) :
    matrixDDT_g_fast k d b = matrixDDT_g k d b := by
  unfold matrixDDT_g_fast matrixDDT_g
  rw [unrot11_eq_rotateRight11]

/-- The fast matrix count computes the exact fixed-key XOR-DDT of `g`. -/
theorem xorDDT_g_eq_matrixDDT_fast (k d b : V 32) :
    xorDDT_g k d b = matrixDDT_g_fast k d b := by
  rw [xorDDT_g_eq_matrixDDT, ← matrixDDT_g_fast_eq]

/-- An executable Boolean feasibility test for an arbitrary output difference.
    Only the eight 4-bit carry-DP steps are computed. -/
def xorDiffPossible (k d b : V 32) : Bool :=
  carryHasPath (wordDigits k) (wordDigits d)
    (wordDigits (b.rotateRight 11))

/-- The Boolean test is true exactly for positive XOR-DDT entries. -/
theorem xorDiffPossible_iff (k d b : V 32) :
    xorDiffPossible k d b = true ↔ 0 < xorDDT_g k d b := by
  unfold xorDiffPossible
  rw [carryHasPath_iff_xorDDT_g_pos]
  rw [rot11_rotateRight11]

/-- A failed carry reachability test certifies a zero XOR-DDT entry. -/
theorem xorDiffPossible_false_iff (k d b : V 32) :
    xorDiffPossible k d b = false ↔ xorDDT_g k d b = 0 := by
  constructor
  · intro hf
    have hn : ¬ 0 < xorDDT_g k d b := by
      intro hp
      have ht := (xorDiffPossible_iff k d b).mpr hp
      rw [hf] at ht
      cases ht
    omega
  · intro hz
    cases h : xorDiffPossible k d b with
    | false => rfl
    | true =>
        have hp := (xorDiffPossible_iff k d b).mp h
        omega

/-- Local *support* of a four-state transition.  Unlike `carryMatrix`,
    this computes a Boolean existential over sixteen input digits rather
    than the number of such digits. -/
def carrySupportMatrix
    (i : Fin 8) (k d out : Fin 16) :
    Matrix CarryState CarryState Bool :=
  Matrix.of (fun s t =>
    decide (∃ x : Fin 16, sboxCarryStep i k d x s = (out, t)))

/-- The local Boolean transition exists iff the corresponding numerical
    transition matrix entry is positive. -/
theorem carrySupportMatrix_iff
    (i : Fin 8) (k d out : Fin 16) (s t : CarryState) :
    carrySupportMatrix i k d out s t = true ↔
      0 < carryMatrix i k d out s t := by
  rw [carryMatrix_pos_iff_input]
  simp only [carrySupportMatrix, Matrix.of_apply, decide_eq_true_eq]

/-- Multiplication of a Boolean reachability row by a Boolean support
    matrix, with `and`/`or` semantics rather than counting paths. -/
def supportRowStep (row : CarryState → Bool)
    (M : Matrix CarryState CarryState Bool) (t : CarryState) : Bool :=
  decide (∃ s : CarryState, row s = true ∧ M s t = true)

/-- A Boolean row transition has exactly the support of the corresponding
    natural-number matrix-vector multiplication. -/
private theorem supportRowStep_correct
    (rb : CarryState → Bool) (rn : CarryState → Nat)
    (Mb : Matrix CarryState CarryState Bool)
    (Mn : Matrix CarryState CarryState Nat)
    (hrow : ∀ s, rb s = true ↔ 0 < rn s)
    (hmat : ∀ s t, Mb s t = true ↔ 0 < Mn s t)
    (t : CarryState) :
    supportRowStep rb Mb t = true ↔
      0 < Matrix.vecMul rn Mn t := by
  simp only [supportRowStep, decide_eq_true_eq]
  rw [vecMul_nat_pos_iff]
  constructor
  · rintro ⟨s, hs, hm⟩
    exact ⟨s, (hrow s).mp hs, (hmat s t).mp hm⟩
  · rintro ⟨s, hs, hm⟩
    exact ⟨s, (hrow s).mpr hs, (hmat s t).mpr hm⟩

/-- The Boolean initial row has a single reachable state `(0,0)`. -/
def supportInitialRow (s : CarryState) : Bool :=
  decide (0 < initialRow s)

private theorem supportInitialRow_correct (s : CarryState) :
    supportInitialRow s = true ↔ 0 < initialRow s := by
  simp only [supportInitialRow, decide_eq_true_eq]

/-- Generic support preservation under an ordered sequence of matrices.
    This lemma is polymorphic in the matrix sequence; it does not unfold
    the concrete eight-nibble Magma transition system. -/
private theorem foldSupport_correct :
    ∀ (n : Nat)
      (Mb : Fin n → Matrix CarryState CarryState Bool)
      (Mn : Fin n → Matrix CarryState CarryState Nat)
      (_hmat : ∀ i s t, Mb i s t = true ↔ 0 < Mn i s t)
      (rb : CarryState → Bool) (rn : CarryState → Nat)
      (_hrow : ∀ s, rb s = true ↔ 0 < rn s)
      (t : CarryState),
      (Fin.foldl n (fun row i => supportRowStep row (Mb i)) rb) t = true ↔
        0 < (Fin.foldl n (fun row i => Matrix.vecMul row (Mn i)) rn) t := by
  intro n
  induction n with
  | zero =>
      intro Mb Mn hmat rb rn hrow t
      simpa only [Fin.foldl_zero] using hrow t
  | succ n ih =>
      intro Mb Mn hmat rb rn hrow t
      rw [Fin.foldl_succ_last, Fin.foldl_succ_last]
      exact supportRowStep_correct
        (Fin.foldl n
          (fun row i => supportRowStep row (Mb i.castSucc)) rb)
        (Fin.foldl n
          (fun row i => Matrix.vecMul row (Mn i.castSucc)) rn)
        (Mb (Fin.last n)) (Mn (Fin.last n))
        (by
          intro s
          exact ih
            (fun i => Mb i.castSucc)
            (fun i => Mn i.castSucc)
            (by intro i u v; exact hmat i.castSucc u v)
            rb rn hrow s)
        (by intro s u; exact hmat (Fin.last n) s u)
        t

/-- Eight-nibble reachability using ONLY Boolean transition matrices.
    This avoids even the small natural-number path counts at each step. -/
def carrySupportDP (key diff target : Fin 8 → Fin 16) :
    CarryState → Bool :=
  Fin.foldl 8
    (fun row i => supportRowStep row
      (carrySupportMatrix i (key i) (diff i) (target i)))
    supportInitialRow

/-- The four Boolean DP entries agree with positivity of the
    previously verified natural-number carry DP entries. -/
theorem carrySupportDP_iff
    (key diff target : Fin 8 → Fin 16) (t : CarryState) :
    carrySupportDP key diff target t = true ↔
      0 < carryDP key diff target t := by
  unfold carrySupportDP carryDP
  exact foldSupport_correct 8
    (fun i => carrySupportMatrix i (key i) (diff i) (target i))
    (fun i => carryMatrix i (key i) (diff i) (target i))
    (by
      intro i s u
      exact carrySupportMatrix_iff i (key i) (diff i) (target i) s u)
    supportInitialRow initialRow supportInitialRow_correct t

/-- A pure Boolean feasibility test (four states, eight steps).
    A final carry state can be arbitrary because overflow is discarded. -/
def carryHasPathBoolean (key diff target : Fin 8 → Fin 16) : Bool :=
  decide (∃ t : CarryState, carrySupportDP key diff target t = true)

/-- Pure Boolean reachability agrees with the old numeric-support test. -/
theorem carryHasPathBoolean_iff
    (key diff target : Fin 8 → Fin 16) :
    carryHasPathBoolean key diff target = true ↔
      carryHasPath key diff target = true := by
  simp only [carryHasPathBoolean, carryHasPath, decide_eq_true_eq]
  constructor
  · rintro ⟨s, hs⟩
    exact ⟨s, (carrySupportDP_iff key diff target s).mp hs⟩
  · rintro ⟨s, hs⟩
    exact ⟨s, (carrySupportDP_iff key diff target s).mpr hs⟩

/-- Executable XOR-differential feasibility test using a Boolean
    four-state automaton and the computable inverse rotation. -/
def xorDiffPossibleBoolean (k d b : V 32) : Bool :=
  carryHasPathBoolean (wordDigits k) (wordDigits d)
    (wordDigits (b.rotateRight 11))

/-- Boolean reachability is equivalent to the exact fixed-key XOR-DDT
    having a nonzero entry. -/
theorem xorDiffPossibleBoolean_iff
    (k d b : V 32) :
    xorDiffPossibleBoolean k d b = true ↔
      0 < xorDDT_g k d b := by
  exact (carryHasPathBoolean_iff
    (wordDigits k) (wordDigits d)
    (wordDigits (b.rotateRight 11))).trans
      (xorDiffPossible_iff k d b)

/-- A failed Boolean automaton check certifies an impossible XOR
    differential of the round function, without enumerating 2^32 inputs. -/
theorem xorDiffPossibleBoolean_false_iff
    (k d b : V 32) :
    xorDiffPossibleBoolean k d b = false ↔
      xorDDT_g k d b = 0 := by
  constructor
  · intro hf
    have hn : ¬ 0 < xorDDT_g k d b := by
      intro hp
      have ht := (xorDiffPossibleBoolean_iff k d b).mpr hp
      rw [hf] at ht
      cases ht
    omega
  · intro hz
    cases h : xorDiffPossibleBoolean k d b with
    | false => rfl
    | true =>
        have hp := (xorDiffPossibleBoolean_iff k d b).mp h
        omega

/-- A zero input XOR difference cannot give a nonzero output XOR
    difference for any fixed key or deterministic round function. -/
private theorem xorDDT_g_zero_input_ne
    (k b : V 32) (hb : b ≠ (0#32)) :
    xorDDT_g k (0#32) b = 0 := by
  unfold xorDDT_g
  have hempty :
      ((Finset.univ : Finset (V 32)).filter (fun x =>
        xor (g k (xor x (0#32))) (g k x) = b)) = ∅ := by
    apply Finset.filter_eq_empty_iff.mpr
    intro x _ hx
    have hzero :
        xor (g k (xor x (0#32))) (g k x) = (0#32) := by
      change (g k (x ^^^ (0#32))) ^^^ (g k x) = (0#32)
      rw [BitVec.xor_zero, BitVec.xor_self]
    exact hb (hzero.symm.trans hx).symm
  rw [hempty]
  rfl

/-- A zero input XOR difference always permits zero output difference. -/
private theorem xorDDT_g_zero_input_zero_pos (k : V 32) :
    0 < xorDDT_g k (0#32) (0#32) := by
  unfold xorDDT_g
  rw [Finset.card_pos]
  refine ⟨(0#32), ?_⟩
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  change (g k ((0#32) ^^^ (0#32))) ^^^ (g k (0#32)) = (0#32)
  simp only [BitVec.xor_self]

/-- Short-circuit the easy zero-input case; other cases use the verified
    eight-step Boolean carry automaton. -/
def xorDiffPossibleBooleanFast (k d b : V 32) : Bool :=
  if d = (0#32) then decide (b = (0#32))
  else xorDiffPossibleBoolean k d b

/-- The fast-path implementation has exactly the same semantics. -/
theorem xorDiffPossibleBooleanFast_eq
    (k d b : V 32) :
    xorDiffPossibleBooleanFast k d b = xorDiffPossibleBoolean k d b := by
  unfold xorDiffPossibleBooleanFast
  by_cases hd : d = (0#32)
  · subst d
    by_cases hb : b = (0#32)
    · subst b
      have ht : xorDiffPossibleBoolean k (0#32) (0#32) = true :=
        (xorDiffPossibleBoolean_iff k (0#32) (0#32)).mpr
          (xorDDT_g_zero_input_zero_pos k)
      simp [ht]
    · have hf : xorDiffPossibleBoolean k (0#32) b = false :=
        (xorDiffPossibleBoolean_false_iff k (0#32) b).mpr
          (xorDDT_g_zero_input_ne k b hb)
      simp [hb, hf]
  · simp [hd]

/-- No bit-vector enumeration is needed for these examples. -/
example : xorDiffPossibleBooleanFast (0#32) (0#32) (0#32) = true := by
  decide

example : xorDiffPossibleBooleanFast (0#32) (0#32) (1#32) = false := by decide

/-- A complete nibble path in the original Magma carry automaton.
    It is a proof object, not a search-side claim. -/
structure VerifiedCarryPath
    (key diff target : Fin 8 → Fin 16) where
  input : Fin 8 → Fin 16
  states : Fin 9 → CarryState
  initial : states 0 = ((0, 0) : CarryState)
  step : ∀ i : Fin 8,
    sboxCarryStep i (key i) (diff i) (input i)
      (states i.castSucc) = (target i, states i.succ)

-- Turn a true `carryHasPathBoolean` into an actual eight-nibble
-- `VerifiedCarryPath`. Certificate soundness can therefore use concrete
-- paths obtained from the original model, independently of the search code.

/-! ## An accepted original carry automaton has a concrete path -/

/-- All states of a concrete 32-bit two-addition computation,
    including its initial state and the last discarded carries. -/
private def actualCarryStates (k d x : V 32) : Fin 9 → CarryState :=
  fun j =>
    (incomingCarry (wordDigitStream x) (wordDigitStream k) j.val,
     incomingCarry (wordDigitStream (xor x d)) (wordDigitStream k) j.val)

/-- Obtain a concrete nibble path from the original Boolean matrix DP.
    Crucially, this does not assume correctness of any UInt8/UInt16 search code.
    It relies on the previously proved exact path-counting theorem. -/
theorem verifiedCarryPath_of_carryHasPathBoolean
    (k d out : V 32)
    (h : carryHasPathBoolean (wordDigits k) (wordDigits d)
      (wordDigits out) = true) :
    Nonempty (VerifiedCarryPath (wordDigits k) (wordDigits d)
      (wordDigits out)) := by
  have hmat :
      0 < carryMatrixCount (wordDigits k) (wordDigits d)
        (wordDigits out) :=
    (carryHasPath_iff_count_pos _ _ _).mp
      ((carryHasPathBoolean_iff _ _ _).mp h)
  have hwords : 0 < carryWordCount k d out := by
    rw [carryWordCount_eq_carryMatrixCount]
    exact hmat
  unfold carryWordCount at hwords
  obtain ⟨x, hx⟩ := Finset.card_pos.mp hwords
  have htrace :
      (carryTrace (wordDigits k) (wordDigits d)
        (wordDigits out) (wordDigits x)).2 = true := by
    exact (Finset.mem_filter.mp hx).2
  have hall := (carryTrace_iff_nibbleDifferences k d out x).mp htrace
  let states : Fin 9 → CarryState := actualCarryStates k d x
  refine ⟨{
    input := wordDigits x
    states := states
    initial := ?_
    step := ?_
  }⟩
  · -- Both additions begin with zero incoming carry.
    rfl
  · intro i
    have hlocal := (localSBoxDifference_eq_iff k d out x i).mpr (hall i)
    have hstep := sboxCarryStep_word_correct k d x i
    rw [hlocal] at hstep
    -- The `wordCarryPair` in the old theorem unfolds to `states`.
    simpa only [states, actualCarryStates, wordCarryPair, Fin.val_castSucc, Fin.val_succ] using hstep

end Magma.CarryAutomaton
